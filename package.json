{
  "_v": "3.2.5-lqvp",
  "type": "module",
  "main": "./built/index.js",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --expose-gc ./built",
    "start-daemon": "nodemon ./built",
    "dev": "concurrently -k -p \"[{name}]\" -n \"TSC,NODE\" -c \"cyan.bold,green.bold\" \"pnpm dev:tsc\" \"pnpm dev:nodemon\"",
    "dev:tsc": "chokidar \"src/**/*.ts\" -c \"pnpm build\"",
    "dev:nodemon": "nodemon --watch built --ext js --delay 1500ms built/index.js",
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests --write",
    "lint:ci": "biome ci src tests",
    "format": "biome format src tests --write",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "--frozen-lockfile": "1.0.0",
    "@iarna/toml": "2.2.5",
    "@napi-rs/canvas": "1.0.13",
    "chalk": "6.0.1",
    "fast-xml-parser": "5.11.2",
    "got": "16.1.0",
    "lokijs": "1.5.12",
    "misskey-js": "2026.10.1",
    "promise-retry": "2.0.1",
    "random-seed": "0.3.0",
    "reconnecting-websocket": "4.4.0",
    "seedrandom": "3.0.5",
    "twemoji-parser": "14.0.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/iarna__toml": "2.0.5",
    "@types/lokijs": "1.5.14",
    "@types/node": "24.19.2",
    "@types/promise-retry": "1.1.6",
    "@types/random-seed": "0.3.5",
    "@types/seedrandom": "3.0.8",
    "@types/twemoji-parser": "13.1.4",
    "@types/ws": "8.18.2",
    "chokidar-cli": "3.0.0",
    "concurrently": "10.0.6",
    "nodemon": "3.1.14",
    "tsc-alias": "^1.8.16",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "nodemonConfig": {
    "ignore": [
      "memory.json",
      "built/*.js.map",
      "built/*.d.ts",
      "built/*.d.ts.map"
    ],
    "delay": "1500",
    "ext": "js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome"
    ]
  }
}
